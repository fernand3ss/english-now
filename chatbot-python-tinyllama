        "!pip install transformers torch\n",
        "\n",
        "from transformers import pipeline\n",
        "\n",
        "# 1. Carregar o modelo leve(TinyLlame é rápido e pequeno)\n",
        "# Isso baixará o modelo (aprox. 1GGB e 2GB) na primeira execução\n",
        "print(\"Carregando modelo... (aguarde)\")\n",
        "pipe = pipeline(\"text-generation\", model=\"TinyLlama/TinyLlama-1.1B-Chat-v1.0\")\n",
        "\n",
        "print(\"--- Chatbot Local Iniciado ---\")\n",
        "print(\"Digite 'sair' para encerrar.\")\n",
        "\n",
        "# Histórico de conversas (para contexto)\n",
        "messages = [\n",
        "    {\"role\": \"system\", \"content\": \"Você é um assistente pessoal útil e educado.\"},\n",
        "]\n",
        "\n",
        "while True:\n",
        "    user_input = input(\"\\nVocê: \")\n",
        "    if user_input.lower() == 'sair':\n",
        "        break\n",
        "\n",
        "   # Adicionar input do usuário ao histórico\n",
        "messages.append({\"role\": \"user\", \"content\": user_input})\n",
        "\n",
        "   # 2. Gerar resposta\n",
        "   # max_new_tokens controla o tamanho da resposta\n",
        "response = pipe(messages, max_new_tokens=256)\n",
        "\n",
        "   # extrair resposta\n",
        "chat_response = response[0]['generated_text'][-1]['content']\n",
        "print(f\"IA: {chat_response}\")\n",
        "\n",
        "   # Adicionar respostas da ia ao histórico\n",
        "messages.append({\"role\": \"assistant\", \"content\": chat_response})\n"
      ]
    }
